{
  "name": "vanilla-chat",
  "version": "0.1.1",
  "description": "Simple web chat UI for Ollama",
  "main": "server.js",
  "scripts": {
    "start": "node start.js",
    "dev": "node --watch server.js",
    "build": "bash scripts/build-desktop.sh",
    "build:install": "bash scripts/build-desktop.sh --copy",
    "electron": "npm --prefix electron start",
    "electron:install": "npm --prefix electron install",
    "gelectron": "npm --prefix gelectron start",
    "gelectron:install": "npm --prefix gelectron install"
  },
  "dependencies": {
    "cjs": "^0.0.11",
    "electron": "^43.2.0",
    "express": "^4.21.0",
    "gelectron-core": "^0.1.1",
    "gelectron-ollama": "file:../gelectron-ollama",
    "multer": "^2.2.0",
    "sharp": "^0.35.3",
    "uuid": "^11.1.1",
    "vosk-browser": "^0.0.8"
  }
}
